// Generate the SVG with:
// dot -Tsvg kvm-execution-flow.dot -o kvm-execution-flow.svg
digraph kvm_execution_flow {
  graph [
    bgcolor="#ffffff"
    compound=true
    fontname="sans-serif"
    newrank=true
    nodesep=0.65
    pad=0.25
    rankdir=TB
    ranksep=0.85
    splines=spline
  ]

  node [
    shape=box
    style="rounded,filled"
    color="#64748b"
    fillcolor="#ffffff"
    fontname="sans-serif"
    fontsize=12
    margin="0.18,0.12"
    penwidth=1.2
  ]

  edge [
    color="#475569"
    fontcolor="#334155"
    fontname="sans-serif"
    fontsize=10
    arrowsize=0.8
    penwidth=1.2
  ]

  subgraph cluster_userspace {
    label="Host userspace"
    labelloc="t"
    labeljust="l"
    color="#94a3b8"
    fillcolor="#f8fafc"
    fontname="sans-serif"
    fontsize=14
    margin=20
    penwidth=1.2
    style="rounded,filled"

    virsh [label="virsh\n(client)"]
    libvirt [label="libvirt daemon\n(libvirtd)"]
    qemu [label="QEMU\n(VMM / device model)"]

    { rank=same; virsh; libvirt; qemu }

    virsh -> libvirt [
      label="domain 操作"
      color="#2563eb"
      fontcolor="#1d4ed8"
      style=dashed
    ]
    libvirt -> qemu [
      label="QEMU process を\n起動・設定"
      color="#2563eb"
      fontcolor="#1d4ed8"
      style=dashed
    ]
  }

  subgraph cluster_kernel {
    label="Host kernel"
    labelloc="t"
    labeljust="l"
    color="#94a3b8"
    fillcolor="#f8fafc"
    fontname="sans-serif"
    fontsize=14
    margin=20
    penwidth=1.2
    style="rounded,filled"

    kvm [label="KVM\n(/dev/kvm)"]
  }

  subgraph cluster_cpu {
    label="CPU"
    labelloc="t"
    labeljust="l"
    color="#94a3b8"
    fillcolor="#f8fafc"
    fontname="sans-serif"
    fontsize=14
    margin=20
    penwidth=1.2
    style="rounded,filled"

    guest [label="guest vCPU を実行\n(VT-x / AMD-V)"]
  }

  qemu -> kvm [
    label="ioctl(KVM_RUN)"
  ]
  kvm -> guest [
    label="VM entry / re-entry\n(Intel: VMLAUNCH / VMRESUME)"
  ]
  guest -> kvm [
    label="VM exit"
    constraint=false
  ]
  kvm -> qemu [
    label="userspace 処理が必要\nKVM_RUN returns\n(KVM_EXIT_MMIO など)"
    constraint=false
  ]
}
